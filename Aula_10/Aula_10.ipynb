     ]
    }
   ],
   "source": [
    "## Analisar o modelo a longo prazo:\n",
    "A = np.array([\n",
    "    [0.95, 0.05, 0, 0],\n",
    "    [0.04, 0.85, 0.1, 0.01],\n",
    "    [0, 0, 1, 0],\n",
    "    [0, 0, 0, 1]\n",
    "])\n",
    "autovalor, autovetor = np.linalg.eig(A.T)\n",
    "print('Autovalores:')\n",
    "print(autovalor)\n",
    "\n",
    "# Simular Comportamento da infecção:\n",
    "t = np.linspace(0, 100, 101)\n",
    "x0 = np.array([.99, 0.01, .0, 0])  # Estado inicial: 100% Suscetível, 0% Infectado, 0% Recuperado, 0% Morto\n",
    "x_t = np.zeros((len(t), len(x0)))\n",
    "x_t[0] = x0\n",
    "\n",
    "for i in range(len(t)-1):\n",
    "    x_t[i+1] = A.T@x_t[i]\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 42,
   "id": "4a8d4613",
