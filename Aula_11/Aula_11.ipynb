    "# APLICAR SVD\n",
    "U, S, Vt = np.linalg.svd(img, full_matrices=True)\n",
    "\n",
    "print(U.shape)\n",
    "print(S.shape)\n",
    "print(Vt.shape)\n",
    "Sigma = np.zeros(img.shape)\n",
    "n_sigm  = len(S)\n",
    "Sigma[:n_sigm, :n_sigm] = np.diag(S)\n",
    "A_reconst = U @ Sigma @ Vt\n",
    "\n",
    "plt.imshow(A_reconst, cmap='gray')"
   ]
